<?xml version="1.0" encoding="utf-8"?>
<!--
  No remote feeds: the only package these projects use is FSharp.Core, which
  the .NET SDK ships in its FSharp/library-packs folder (added to restore
  automatically). Clearing the sources keeps the build working offline.
-->
<configuration>
  <packageSources>
    <clear />
  </packageSources>
</configuration>
