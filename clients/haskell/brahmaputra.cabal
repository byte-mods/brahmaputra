cabal-version:      2.4
name:               brahmaputra
version:            0.1.0
synopsis:           Native client for the Brahmaputra log broker
description:
  Producer, partition consumer and consumer groups speaking Brahmaputra's
  own wire protocol directly: BitPacker bodies, CRC32C record batches,
  Kafka murmur2 partitioning, gzip built in and other codecs pluggable.
license:            Apache-2.0
category:           Network
build-type:         Simple
extra-doc-files:    README.md

common shared
  default-language: Haskell2010
  ghc-options:      -Wall
  build-depends:
      base       >=4.14 && <5
    , bytestring >=0.10
    , containers >=0.6
    , network    >=3.1
    , stm        >=2.5
    , text       >=1.2
    , time       >=1.9
    , array      >=0.5
    , zlib       >=0.6

library
  import:           shared
  hs-source-dirs:   src
  exposed-modules:
      Brahmaputra
      Brahmaputra.Protocol
      Brahmaputra.Connection
      Brahmaputra.Producer
      Brahmaputra.Consumer
      Brahmaputra.Group
      Brahmaputra.Assignor

-- The end-to-end suite: cabal run manualtest -- HOST PORT
executable manualtest
  import:           shared
  main-is:          ManualTest.hs
  hs-source-dirs:   test
  ghc-options:      -threaded -O1
  build-depends:    brahmaputra
