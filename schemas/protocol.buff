// Brahmaputra data-plane message schemas (BitPacker).
//
// Frame layout on the wire:
//   length:i32  api_key:i16  api_version:i16  correlation_id:i32  client_id:string  body
//
// `body` is a BitPacker-encoded struct from this schema. For requests that
// carry record batches (Produce) or return them (Fetch), the batch bytes are
// NOT inside the BitPacker struct — they are appended after the encoded
// struct as opaque raw bytes, with `batches_length` giving their total size.
// BitPacker v1.0 has no native bytes type (only int/long/float/double/bool/
// string/classes/arrays), and varint-encoding bytes would inflate binary
// payloads ~1.6x — so batches stay zero-copy raw bytes on the wire.
//
// Type mapping note: BitPacker `int` -> Rust i32 (zigzag varint),
// `long` -> Rust i64. All offsets and timestamps are `long`.
//
// Generated Rust API per struct:
//   encode(&self) -> Result<Vec<u8>>
//   encode_to(&self, buf: &mut ZeroCopyByteBuff) -> Result<()>
//   decode(data: &[u8]) -> Result<Self>
//   decode_from(buf: &mut ZeroCopyByteBuff) -> Result<Self>
//
// Regenerate: bitpacker --file schemas/protocol.buff --lang rust --out crates/protocol/src/gen --sep

version = 1.0.0

// ---------- Produce (api_key 0) ----------

class ProduceRequest {
    string topic;
    int partition;
    int acks;              // 0, 1, -1 (all)
    int timeout_ms;
    long batches_length;   // bytes of raw record-batch data trailing the struct
}

class ProduceResponse {
    string topic;
    int partition;
    int error_code;        // 0 = none
    long base_offset;
    long log_append_time_ms;
}

// ---------- Fetch (api_key 1) ----------

class FetchRequest {
    string topic;
    int partition;
    long fetch_offset;
    int max_bytes;
    int max_wait_ms;       // long poll
    int min_bytes;         // return early when at least this many bytes ready
    // 0 = read_uncommitted, 1 = read_committed. A committed read stops at
    // the last stable offset instead of the high watermark, and never sees
    // an aborted transaction's records or a control marker.
    int isolation_level;
    // The consumer's own failure domain (`client.rack`), empty when it has
    // none. Non-empty asks the leader to name a replica in that rack that
    // this consumer could read from instead, which is what keeps a fetch
    // inside one availability zone (KIP-392).
    string rack;
}

class FetchResponse {
    string topic;
    int partition;
    int error_code;
    long high_watermark;
    long last_stable_offset;
    long batches_length;   // bytes of raw record-batch data trailing the struct
    // Broker this consumer should fetch this partition from instead, or
    // -1 to keep reading here. Named by the leader, which is the only
    // node that knows the current ISR, so a consumer never has to guess
    // which replica is caught up enough to serve it.
    int preferred_read_replica;
}

// ---------- ListOffsets (api_key 2) ----------

class ListOffsetsRequest {
    string topic;
    int partition;
    long timestamp;        // -1 = latest, -2 = earliest, else unix ms
}

class ListOffsetsResponse {
    string topic;
    int partition;
    int error_code;
    long offset;
    long timestamp;
}

// ---------- Metadata (api_key 3) ----------

class BrokerInfo {
    int broker_id;
    string host;
    int port;
    // Failure domain this broker is in, empty when it was started without
    // --rack. A consumer that knows its own rack uses this to ask for a
    // replica it can read without crossing a zone boundary.
    string rack;
}

class PartitionInfo {
    int partition;
    int leader;            // broker_id, -1 = no leader
    int[] replicas;
    int[] isr;
    int leader_epoch;
}

class TopicInfo {
    string name;
    int error_code;
    PartitionInfo[] partitions;
}

class MetadataRequest {
    string[] topics;       // empty = all topics
}

class MetadataResponse {
    // Request-level failure, distinct from a topic that does not exist.
    // Without it an authorization denial is reported to the client as an
    // unknown topic, which sends an operator looking for the wrong thing.
    int error_code;
    BrokerInfo[] brokers;
    int controller_id;
    TopicInfo[] topics;
}

// ---------- JoinGroup (api_key 7) ----------

class GroupMemberInfo {
    string member_id;
    string[] subscription_topics;
    // What this member holds right now. The group leader needs it to
    // compute a sticky assignment: without it, "minimise movement" has
    // nothing to measure movement against.
    AssignedPartition[] assignment;
}

class JoinGroupRequest {
    string group_id;
    int session_timeout_ms;
    int rebalance_timeout_ms;
    string member_id;        // empty = new member, coordinator assigns one
    string[] subscription_topics;
    // Stable identity across restarts (KIP-345). Empty = dynamic member.
    // A static member reclaims its previous member_id, so a rolling
    // restart does not rebalance the group twice per instance.
    string group_instance_id;
}

class JoinGroupResponse {
    int error_code;
    int generation;
    string member_id;
    string leader_member_id;
    GroupMemberInfo[] members;   // populated only for the group leader
}

// ---------- SyncGroup (api_key 8) ----------

class AssignedPartition {
    string topic;
    int partition;
}

class MemberAssignment {
    string member_id;
    AssignedPartition[] partitions;
}

class SyncGroupRequest {
    string group_id;
    int generation;
    string member_id;
    MemberAssignment[] assignments;  // set by group leader only, empty from others
}

class SyncGroupResponse {
    int error_code;
    AssignedPartition[] assignment;  // this member's assignment
}

// ---------- Heartbeat (api_key 9) ----------

class HeartbeatRequest {
    string group_id;
    int generation;
    string member_id;
}

class HeartbeatResponse {
    int error_code;
}

// ---------- OffsetCommit (api_key 10) ----------

class OffsetCommitEntry {
    string topic;
    int partition;
    long offset;
}

class OffsetCommitRequest {
    string group_id;
    int generation;          // -1 = commit outside an active membership
    string member_id;
    OffsetCommitEntry[] offsets;
}

class OffsetCommitResponse {
    int error_code;
}

// ---------- OffsetFetch (api_key 11) ----------

class OffsetFetchRequest {
    string group_id;
    AssignedPartition[] partitions;  // empty = all partitions of the group
}

class OffsetFetchEntry {
    string topic;
    int partition;
    long offset;             // -1 = no committed offset
}

class OffsetFetchResponse {
    int error_code;
    OffsetFetchEntry[] offsets;
}

// ---------- ListGroups (api_key 12) ----------
// Answered per broker: a broker reports only the groups whose coordinator
// partition it currently leads, so a cluster-wide listing is the union of
// every broker's response.

class ListedGroup {
    string group_id;
    string state;                    // Empty|PreparingRebalance|AwaitingSync|Stable|Dead
    int generation;
    int member_count;
    int coordinator_partition;       // __consumer_offsets partition
}

class ListGroupsRequest {
    string[] states;                 // empty = every state
}

class ListGroupsResponse {
    int error_code;
    ListedGroup[] groups;
}

// ---------- DescribeGroup (api_key 13) ----------
// Answered by the group's coordinator only; carries membership plus every
// committed offset the coordinator holds for the group. Lag is derived by
// the caller against each partition's log end offset (ListOffsets).

class DescribedMember {
    string member_id;
    string[] subscription_topics;
    AssignedPartition[] assignment;
}

class DescribeGroupRequest {
    string group_id;
}

class DescribeGroupResponse {
    int error_code;
    string group_id;
    string state;
    int generation;
    string leader_member_id;
    int coordinator_partition;
    DescribedMember[] members;
    OffsetFetchEntry[] offsets;      // committed offsets, -1 = none
}

// ---------- ProduceMulti (api_key 15) / FetchMulti (api_key 16) ----------
// The multi-partition forms of Produce and Fetch, and the ones clients
// should use. A client talking to one broker about six partitions sends
// one request instead of six, which is the difference between paying the
// per-request cost once and paying it per partition — the dominant cost
// at small record sizes.
//
// Raw record batches trail the encoded struct exactly as they do for the
// single-partition APIs, concatenated in the order the partitions appear;
// each partition's `batches_length` says how many bytes belong to it.

class ProduceMultiPartition {
    string topic;
    int partition;
    long batches_length;
}

class ProduceMultiRequest {
    int acks;
    int timeout_ms;
    ProduceMultiPartition[] partitions;
}

class ProduceMultiResult {
    string topic;
    int partition;
    int error_code;
    long base_offset;
    long log_append_time_ms;
}

class ProduceMultiResponse {
    ProduceMultiResult[] results;
}

class FetchMultiPartition {
    string topic;
    int partition;
    long fetch_offset;
    int max_bytes;
}

class ForgottenPartition {
    string topic;
    int partition;
}

class FetchMultiRequest {
    int max_wait_ms;          // long poll, applied across the whole request
    int min_bytes;            // return early once this many bytes are ready
    int isolation_level;      // 0 = read_uncommitted, 1 = read_committed
    string rack;              // `client.rack`, empty when the consumer has none
    // Incremental fetch session (KIP-227). A consumer holding a thousand
    // partitions of which three are moving resends all thousand on every
    // poll; with a session it resends the three. `session_id` is 0 until
    // the broker issues one, `session_epoch` is 0 to open a session, a
    // positive number to continue one, and -1 to close it.
    int session_id;
    int session_epoch;
    // Every partition when opening a session or fetching without one;
    // only the ones whose fetch offset changed when continuing.
    FetchMultiPartition[] partitions;
    // Partitions to drop from the session — an assignment this consumer
    // no longer holds. Without it a rebalance would leave the broker
    // fetching partitions nobody is reading.
    ForgottenPartition[] forgotten;
}

class FetchMultiResult {
    string topic;
    int partition;
    int error_code;
    long high_watermark;
    long last_stable_offset;
    long batches_length;      // bytes of this partition's trailing batches
    int preferred_read_replica; // broker to read from instead, or -1
}

class FetchMultiResponse {
    // The session this response belongs to, and the epoch the next request
    // must carry. Zero means no session was established, which is a
    // complete answer rather than a failure: the client simply keeps
    // sending full fetches.
    int session_id;
    int session_epoch;
    // Request-level failure, distinct from a per-partition one: an
    // unknown session or an epoch that has gone out of step. The client
    // answers both the same way — start again with a full fetch — which
    // is why they are reported here rather than smeared across the
    // partitions.
    int error_code;
    FetchMultiResult[] results;
}

// ---------- ApiVersions (api_key 14) ----------
// The one API a broker must answer regardless of the requested api_version:
// it is how a client discovers what the broker speaks before sending
// anything else, which is what makes a rolling upgrade possible.

class ApiVersionRange {
    int api_key;
    int min_version;
    int max_version;
}

class ApiVersionsRequest {
    string client_software_name;
    string client_software_version;
}

class ApiVersionsResponse {
    int error_code;
    ApiVersionRange[] api_versions;
    string broker_version;
    int throttle_time_ms;          // >0 when a quota delayed this response
}

// ---------- Internal __consumer_offsets record payloads ----------
// Not wire APIs: encoded with the same generated code and stored as record
// values in the internal offsets topic. The record value is prefixed with a
// one-byte kind tag: 1 = OffsetCommitRecord, 2 = GroupMetadataRecord,
// 3 = TombstoneRecord. The record key carries "group/topic/partition"
// (or just "group" for metadata) to enable later log compaction.

class OffsetCommitRecord {
    string group_id;
    string topic;
    int partition;
    long offset;
    long commit_timestamp_ms;
}

class GroupMemberRecord {
    string member_id;
    string[] subscription_topics;
    AssignedPartition[] assignment;
    // Preserved across coordinator failover, or a static member would be
    // rebuilt as a dynamic one and lose the very identity that spares the
    // group a rebalance when it restarts.
    string group_instance_id;
}

class GroupMetadataRecord {
    string group_id;
    int generation;
    string leader_member_id;
    GroupMemberRecord[] members;
}

class TombstoneRecord {
    string group_id;
    string topic;            // empty = whole-group tombstone
    int partition;
}

// ---------- Authenticate (api_key 17) ----------
// Binds a principal to the connection. Every later request on that
// connection is authorized as that principal; a connection that never
// authenticates is anonymous, which is refused outright when the broker
// runs with authentication required.
//
// The password crosses the wire in the clear, so this is only meaningful
// over `tcp-tls` or `quic`. That is the same trade SASL/PLAIN makes in
// Kafka, and the broker refuses it on a plaintext listener.

// Two shapes share one API key, distinguished by `mechanism`.
//
// PLAIN sends the password and is refused on a plaintext listener, because
// a password in the clear is only meaningful under encryption.
// SCRAM-SHA-256 never sends it: the client proves it knows the password by
// answering a challenge, which is what makes authentication meaningful on
// a listener that is not encrypted. Its exchange takes two round trips, so
// `payload` carries an RFC 5802 message and `done` says whether the server
// considers the exchange finished.

class AuthenticateRequest {
    string username;
    string password;
    // Empty means PLAIN, for a client that predates mechanisms.
    string mechanism;
    // The SCRAM message for this step; unused by PLAIN.
    string payload;
}

class AuthenticateResponse {
    int error_code;
    string principal;
    string role;
    // The server's SCRAM message for this step; unused by PLAIN.
    string payload;
    // False when the client must send another step.
    bool done;
}

// ---------- LeaveGroup (api_key 18) ----------
// A member announcing its own departure, so the coordinator can rebalance
// immediately instead of waiting out the session timeout.
//
// Without this a clean shutdown is indistinguishable from a crash, and the
// group stalls for `session.timeout.ms` before the departing member's
// partitions move — which is pure downtime during a rolling restart, the
// most common planned operation there is.

class LeaveGroupRequest {
    string group_id;
    string member_id;
}

class LeaveGroupResponse {
    int error_code;
}

// ---------- DescribeCluster (api_key 19) ----------
// What a cluster actually is, from the broker's own view: who is in it,
// which node is the controller, and where each broker sits.
//
// Metadata answers this only in passing, as a by-product of asking about
// topics — so an operator with no topic in mind had no way to ask "what am
// I connected to?" without reading the controller's HTTP API, which a
// data-plane client has no reason to be able to reach.

class DescribeClusterBroker {
    int broker_id;
    string host;
    int port;
    string rack;            // empty when the broker was started without --rack
}

class DescribeClusterRequest {
    bool include_cluster_authorized_operations;
}

class DescribeClusterResponse {
    int error_code;
    string cluster_id;
    int controller_id;      // -1 = no controller elected right now
    DescribeClusterBroker[] brokers;
}

// ---------- DescribeConfigs (api_key 20) ----------
// Read back the configuration in force for a topic or a broker.
//
// Configs could be set but never read: an operator could change
// `retention.ms` and then had no way to confirm what the cluster believed
// it to be. `is_default` is the part that matters — it distinguishes a
// topic that was explicitly set to the same value as the default from one
// that was never set at all, which is exactly the difference that decides
// whether changing the broker default will move it.

class ConfigEntry {
    string name;
    string value;
    bool is_default;        // true = inherited, not set on this resource
}

class DescribeConfigsRequest {
    string resource_type;   // "topic" | "broker"
    string resource_name;   // topic name, or broker id as a string
    string[] config_names;  // empty = every config
}

class DescribeConfigsResponse {
    int error_code;
    string resource_type;
    string resource_name;
    ConfigEntry[] configs;
}

// ---------- DescribeLogDirs (api_key 21) ----------
// How much disk each partition is using on this broker.
//
// Without it, "which topic filled the disk?" is answered by walking the
// data directory by hand on every broker in turn.
//
// `offset_lag` is this replica's own uncommitted tail: log end offset
// minus high watermark. A leader whose followers are keeping up reports
// zero; a number that stays high means records are being written that the
// ISR is not acknowledging, which is the shape of a stalled follower seen
// from the other side. It is deliberately not "how far behind the leader
// is this broker", because a follower does not durably know the leader's
// log end offset and a field that guesses is worse than one that does not.

class LogDirPartition {
    string topic;
    int partition;
    long size_bytes;
    long offset_lag;
    bool is_leader;
}

class LogDirInfo {
    int error_code;
    string log_dir;
    // Why this directory is offline, empty when it is healthy. A disk that
    // failed is worth reporting with its reason: "offline" sends an
    // operator to the machine, "offline: Input/output error" tells them
    // what they will find when they get there.
    string offline_reason;
    long total_bytes;       // -1 when the filesystem could not be queried
    long usable_bytes;      // -1 when the filesystem could not be queried
    LogDirPartition[] partitions;
}

class DescribeLogDirsRequest {
    string[] topics;        // empty = every topic on this broker
}

class DescribeLogDirsResponse {
    int error_code;
    LogDirInfo[] log_dirs;
}

// ---------- DeleteRecords (api_key 22) ----------
// Discard every record below an offset, and reclaim the segments that hold
// only such records.
//
// This is the only way to reclaim space on a topic retention will not
// touch — a compacted one, or one whose retention is deliberately long —
// and the only answer to "delete this data now" that stops short of
// deleting the topic.
//
// The offset is clamped to the committed range. Past the high watermark it
// would discard records the ISR has not all acknowledged, which is data
// loss wearing an admin command's clothes.

class DeleteRecordsPartition {
    string topic;
    int partition;
    long offset;            // delete below this; -1 = up to the high watermark
}

class DeleteRecordsRequest {
    int timeout_ms;
    DeleteRecordsPartition[] partitions;
}

class DeleteRecordsResult {
    string topic;
    int partition;
    int error_code;
    long low_watermark;     // the log start offset after the delete
}

class DeleteRecordsResponse {
    DeleteRecordsResult[] results;
}

// ---------- Transactions (api_keys 23-26) ----------
//
// A transactional producer writes to many partitions and then decides, once,
// whether all of it counts. What makes that atomic is not holding the records
// back — they are appended as they are produced — but *marking* them: each
// partition receives a control batch saying the transaction committed or
// aborted, and a `read_committed` consumer refuses to look past the first
// record of any transaction that has not been marked yet.
//
// The coordinator for a `transactional.id` is the leader of
// `hash(transactional_id) % partitions` of `__transaction_state`, exactly as a
// consumer group's coordinator is chosen from `__consumer_offsets`. A client
// therefore finds it by routing to that partition, with no separate discovery
// API to keep consistent.
//
// `producer_epoch` is an `int` on the wire because BitPacker has no 16-bit
// type; it is narrowed to the i16 the record batch header carries. A request
// whose epoch is behind the coordinator's is fenced — that is what stops a
// producer that was partitioned away from finishing a transaction its
// replacement has already started.

class TxnPartition {
    string topic;
    int partition;
}

// ---------- AddPartitionsToTxn (api_key 23) ----------
// Announce a partition before writing to it, so the coordinator knows where
// to send a marker. A partition the coordinator never heard of would keep its
// records in doubt forever.

class AddPartitionsToTxnRequest {
    string transactional_id;
    long producer_id;
    int producer_epoch;
    TxnPartition[] partitions;
}

class AddPartitionsToTxnResponse {
    int error_code;
}

// ---------- AddOffsetsToTxn (api_key 24) ----------
// Bring a consumer group's offset commits into the transaction, which is what
// makes read-process-write atomic: the offsets advance if and only if the
// output records do.

class AddOffsetsToTxnRequest {
    string transactional_id;
    long producer_id;
    int producer_epoch;
    string group_id;
}

class AddOffsetsToTxnResponse {
    int error_code;
}

// ---------- EndTxn (api_key 25) ----------
// Commit or abort. The coordinator writes a marker to every partition the
// transaction touched and only then records the outcome as complete, so a
// coordinator that dies mid-commit is recovered by replaying its log and
// finishing the markers rather than by guessing.

class EndTxnRequest {
    string transactional_id;
    long producer_id;
    int producer_epoch;
    bool committed;         // false aborts
}

class EndTxnResponse {
    int error_code;
}

// ---------- TxnOffsetCommit (api_key 26) ----------
// Commit consumed offsets as part of a transaction. Sent to the *group*
// coordinator, not the transaction coordinator, because that is where the
// offsets live; the records are transactional, so they become visible only
// when the transaction's marker reaches `__consumer_offsets`.

class TxnOffsetCommitRequest {
    string transactional_id;
    long producer_id;
    int producer_epoch;
    string group_id;
    OffsetCommitEntry[] offsets;
}

class TxnOffsetCommitResponse {
    int error_code;
}

// ---------- Internal __transaction_state record payload ----------
// Not a wire API: the coordinator's durable state for one transactional id,
// stored as the value of a record keyed by that id so the topic compacts to
// the latest state per producer.

class TransactionStateRecord {
    string transactional_id;
    long producer_id;
    int producer_epoch;
    // Empty | Ongoing | PrepareCommit | PrepareAbort | CompleteCommit |
    // CompleteAbort. A string rather than an integer because this is read
    // by operators as often as by code, and a number in a log dump tells
    // nobody anything.
    string state;
    int timeout_ms;
    long last_update_ms;
    TxnPartition[] partitions;
}

// ---------- WriteTxnMarkers (api_key 27) ----------
// Cluster-internal: the transaction coordinator asking a broker to append a
// commit or abort marker to partitions it leads.
//
// A separate API rather than a Produce request because it is a different
// authority. Markers are written by the coordinator on behalf of a producer
// that may already be gone — that is the whole point, since a producer which
// crashes mid-transaction must not leave its records in doubt forever — and
// they must bypass the idempotent-sequence checks that govern client writes.
// Authorized at the cluster level alongside the replication APIs.

class TxnMarker {
    long producer_id;
    int producer_epoch;
    bool committed;
    TxnPartition[] partitions;
}

class WriteTxnMarkersRequest {
    TxnMarker[] markers;
}

class TxnMarkerResult {
    string topic;
    int partition;
    int error_code;
}

class WriteTxnMarkersResponse {
    TxnMarkerResult[] results;
}

// ---------- AlterConfigs (api_key 28) ----------
// Change a topic's configuration from the data plane.
//
// Configuration could already be changed on a running cluster, but only
// through the controller's HTTP API — which means an administrative client
// had to know a second protocol, a second address and a second set of
// credentials to do what DescribeConfigs (key 20) already let it read back
// over this one. The broker forwards to the controller, so the durability
// and ordering of the change are unchanged; what changes is that one
// connection is enough to both read and write a topic's configuration.
//
// `incremental` distinguishes Kafka's two shapes: false replaces the whole
// config map, true merges the entries given and leaves the rest alone. An
// entry with an empty value in incremental mode removes that key, which is
// how a topic is returned to the broker default rather than pinned to
// whatever the default happened to be on the day.

class AlterConfigEntry {
    string name;
    string value;
}

class AlterConfigsRequest {
    string resource_type;   // "topic"
    string resource_name;
    bool incremental;
    AlterConfigEntry[] configs;
}

class AlterConfigsResponse {
    int error_code;
    string resource_type;
    string resource_name;
    // Human-readable reason when error_code is not zero: an operator who
    // mistyped a config name deserves to be told which one.
    string error_message;
}

// ---------- DescribeProducers (api_key 29) ----------
// Which producers have written to a partition, and what state each is in.
//
// This is the answer to "why is my read_committed consumer stuck?", which
// before had no answer short of reading the log by hand. A partition whose
// last stable offset will not advance has exactly one cause — an open
// transaction — and this says which producer owns it and when it last did
// anything.

class ProducerState {
    long producer_id;
    int producer_epoch;
    int last_sequence;
    long last_timestamp_ms;
    // First offset of this producer's open transaction on this partition,
    // or -1 when it has none in flight.
    long current_txn_start_offset;
}

class DescribeProducersRequest {
    string topic;
    int partition;
}

class DescribeProducersResponse {
    int error_code;
    string topic;
    int partition;
    // The offset a read_committed consumer stops at, and the high
    // watermark it would stop at if nothing were open. Reported together
    // because the gap between them *is* the symptom being diagnosed.
    long last_stable_offset;
    long high_watermark;
    ProducerState[] producers;
}

// ---------- ListTransactions (api_key 30) ----------
// Every transactional id this broker coordinates, and what state it is in.
//
// The cluster-wide view of the same question: a transaction that has been
// Ongoing for longer than its timeout is one the coordinator is about to
// abort, and one that has been PrepareCommit for a while is one whose
// markers did not all land.

class TransactionListing {
    string transactional_id;
    long producer_id;
    string state;
    long last_update_ms;
    int timeout_ms;
    int partition_count;
}

class ListTransactionsRequest {
    // Only these states, empty for all.
    string[] states;
}

class ListTransactionsResponse {
    int error_code;
    TransactionListing[] transactions;
}

// ---------- DescribeTransactions (api_key 31) ----------
// One transaction in full, including the partitions it has announced.

class DescribeTransactionsRequest {
    string transactional_id;
}

class DescribeTransactionsResponse {
    int error_code;
    string transactional_id;
    long producer_id;
    int producer_epoch;
    string state;
    int timeout_ms;
    long last_update_ms;
    TxnPartition[] partitions;
}

// ---------- AlterReplicaLogDirs (api_key 32) ----------
// Move a partition from one of a broker's disks to another.
//
// JBOD placed partitions across disks and isolated a disk failure to its
// own partitions, but placement was decided once — when the partition was
// created — and could never be revisited. So a disk added to a running
// broker took only *new* partitions, and a disk filling up could only be
// relieved by deleting a partition and letting it refetch from the leader,
// which is a full re-replication to solve a local problem.
//
// The move is not free: the partition is closed for the duration of the
// copy, so on this broker it is unavailable and, in a cluster, it stops
// fetching and leaves the ISR until it catches up. That is the honest
// trade — Kafka builds a second copy alongside and swaps, which avoids the
// pause at the cost of needing both copies to fit and of a whole
// catch-up-and-swap state machine. Move followers, or hand leadership away
// first.

class AlterLogDirPartition {
    string topic;
    int partition;
    string log_dir;         // absolute path, one of the broker's --data-dir
}

class AlterReplicaLogDirsRequest {
    AlterLogDirPartition[] partitions;
}

class AlterLogDirResult {
    string topic;
    int partition;
    int error_code;
    string log_dir;         // where the partition now lives
    long bytes_moved;
}

class AlterReplicaLogDirsResponse {
    AlterLogDirResult[] results;
}
